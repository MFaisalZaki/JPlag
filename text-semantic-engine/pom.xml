<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.jplag</groupId>
        <artifactId>aggregator</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>text-semantic-engine</artifactId>
    <name>JPlag: Semantic Text Engine</name>
    <description>Standalone plagiarism engine for natural-language text. It maintains a persistent Lucene index of an archive
        (BM25 over WordNet-normalized terms plus SBERT document embeddings) and cross-references new documents against
        it, producing a Turnitin-style HTML originality report per document. Reuses the text language module for
        tokenization and normalization; it does not modify the JPlag comparison core.</description>

    <dependencies>
        <!-- Reused for tokenization + WordNet normalization (lemmatization, stop words, synonyms). -->
        <dependency>
            <groupId>de.jplag</groupId>
            <artifactId>text</artifactId>
        </dependency>
        <dependency>
            <groupId>de.jplag</groupId>
            <artifactId>language-api</artifactId>
        </dependency>

        <!-- Text extraction from PDF documents. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>

        <!-- Local SBERT sentence embeddings (Deep Java Library). -->
        <!-- The PyTorch native runtime and the model are fetched automatically by DJL on first use. -->
        <dependency>
            <groupId>ai.djl</groupId>
            <artifactId>api</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.djl.huggingface</groupId>
            <artifactId>tokenizers</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.djl.pytorch</groupId>
            <artifactId>pytorch-engine</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Persistent, queryable corpus index (inverted index + HNSW vectors) for cross-referencing an archive. -->
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-analysis-common</artifactId>
        </dependency>

        <!-- Command line interface. -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>

        <!-- Logging. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Convenience: mvn -pl text-semantic-engine exec:java -Dexec.args="<corpus-cli-arguments>" -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>de.jplag.text.semantic.CorpusCli</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
